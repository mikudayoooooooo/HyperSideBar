<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- allowBackup 关闭：RelayToken 防伪令牌、熔断状态、应用/快捷方式配置属安全敏感
         的跨进程 IPC 状态，随云备份/换机迁移会导致令牌在新设备失效或被外泄。模块配置
         丢失可由 LSPosed 作用域与重新选择恢复，不做备份（backup_rules/data_extraction_rules
         仍保留供需要时启用）。 -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:description="@string/module_description"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperSidebar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS" />
            </intent-filter>
        </activity>

        <!-- 全部应用面板（fan 圈内末位入口）：:ui/launcher 经 FreeformLauncher 启动，
             freeform 小窗形态（PRD §7.3.2）；exported 供 :ui（system uid）跨进程拉起。
             taskAffinity 独立=修"打开目标后小窗不关"：默认 affinity 会命中设置主任务
             （NEW_TASK 按 affinity 归任务），finish() 后主任务顶上是 MainActivity、
             任务非空窗口不收；独立 affinity 保证面板任务只有自己，finish 即空即关 -->
        <activity
            android:name=".ui.allapps.AllAppsActivity"
            android:taskAffinity="com.lsp.hypersidebar.allapps_panel"
            android:exported="true"
            android:resizeableActivity="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:label="@string/all_apps_title" />

        <!-- :ui → 模块 App 快捷方式 root 代发（§2.4）：非 exported 目标 :ui 静默假成功
             且无 su；模块进程持 root 代发。令牌校验见 ShortcutRelayReceiver -->
        <receiver
            android:name=".ShortcutRelayReceiver"
            android:exported="true" />

        <!-- :ui → 模块 App 解冻 relay（方案 2 bind 唤醒）：bind 本身唤醒冻结/已死的
             模块进程（SmartPower THAW/冷启动），连上后 su 解冻磁贴宿主。
             防伪=服务内 Binder uid + 令牌双重校验 -->
        <service
            android:name=".UnfreezeRelayService"
            android:exported="true" />

        <!-- hook 宿主 → 模块 App 配置拉取（迭代六 §11.1）：ConfigSync 广播对冻结宿主
             静默丢弃，hook 侧 stale 时 bind 本服务拉全量配置兜底（bind 唤醒冻结/死进程）。
             只读无 su，ACL=uid system 或两个 hook 宿主包 -->
        <service
            android:name=".ConfigPullService"
            android:exported="true" />

    </application>

</manifest>
